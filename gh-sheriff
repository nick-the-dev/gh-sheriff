class SheriffError(Exception):
    pass


def say(text):
    print(text, flush=True)


OPEN_BROWSER = True


def open_url(url):
    if OPEN_BROWSER:
        webbrowser.open(url)
    say("    " + url)


def gh(args, stdin=None):
    result = subprocess.run(["gh"] + list(args), input=stdin, capture_output=True, text=True, check=False)
    if result.returncode:
        raise SheriffError("gh " + " ".join(args[:3]) + " failed: " + (result.stderr or result.stdout).strip()[:400])
    return result.stdout


def gh_json(args, stdin=None):
    out = gh(args, stdin)
    return json.loads(out) if out.strip() else None


def gh_status(args):
    return subprocess.run(["gh"] + list(args), capture_output=True, text=True, check=False).returncode == 0


def resolve_repo(explicit):
    if explicit:
        return explicit
    out = subprocess.run(["gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"],
                         capture_output=True, text=True, check=False)
    if out.returncode or not out.stdout.strip():
        raise SheriffError("run this inside a GitHub repository or pass --repo owner/name")
    return out.stdout.strip()


def repo_info(repo):
    data = gh_json(["api", "repos/" + repo])
    permissions = data.get("permissions") or {}
    return {"repo": repo, "id": data["id"], "owner": data["owner"]["login"], "kind": data["owner"]["type"],
            "branch": data["default_branch"], "admin": bool(permissions.get("admin")),
            "auto_merge": bool(data.get("allow_auto_merge"))}


def slug_for(owner):
    return owner.lower() + "-sheriff"


def load_config():
    try:
        return json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        return {}


def remember_app(slug, app_id):
    config = load_config()
    config[slug] = {"id": int(app_id)}
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps(config, indent=2) + "\n")


def known_app_id(slug):
    entry = load_config().get(slug) or {}
    if entry.get("id"):
        return int(entry["id"])
    public = subprocess.run(["gh", "api", "/apps/" + slug, "--jq", ".id"], capture_output=True, text=True, check=False)
    return int(public.stdout.strip()) if public.returncode == 0 and public.stdout.strip().isdigit() else None


def env_secret_names(repo, environment=ENVIRONMENT):
    try:
        data = gh_json(["api", "repos/" + repo + "/environments/" + environment + "/secrets"])
    except SheriffError:
        return set()
    return {item["name"] for item in (data or {}).get("secrets", [])}


def set_env_secret(repo, name, value, environment=ENVIRONMENT):
    gh(["secret", "set", name, "--env", environment, "--repo", repo], stdin=value)


def ensure_environment(info, environment=ENVIRONMENT):
    repo = info["repo"]
    gh_json(["api", "-X", "PUT", "repos/" + repo + "/environments/" + environment, "--input", "-"],
            json.dumps({"deployment_branch_policy": {"protected_branches": False, "custom_branch_policies": True}}))
    policies = gh_json(["api", "repos/" + repo + "/environments/" + environment + "/deployment-branch-policies"]) or {}
    names = {item.get("name") for item in policies.get("branch_policies", [])}
    for extra in names - {info["branch"]}:
        policy = next(item for item in policies["branch_policies"] if item.get("name") == extra)
        gh(["api", "-X", "DELETE", "repos/" + repo + "/environments/" + environment + "/deployment-branch-policies/" + str(policy["id"])])
    if info["branch"] not in names:
        gh(["api", "-X", "POST", "repos/" + repo + "/environments/" + environment + "/deployment-branch-policies",
            "-f", "name=" + info["branch"], "-f", "type=branch"])
    say("ok  environment '" + environment + "' is limited to " + info["branch"])


def manifest(owner, port):
    return {"name": slug_for(owner), "url": "https://github.com/nick-the-dev/gh-sheriff",
            "redirect_url": "http://127.0.0.1:%d/callback" % port, "public": False,
            "default_permissions": GATE_PERMISSIONS, "default_events": []}


def create_gate_app(info, port=8767):
    owner, state = info["owner"], secrets.token_urlsafe(24)
    action = ("https://github.com/organizations/%s/settings/apps/new?state=%s" % (owner, state) if info["kind"] == "Organization"
              else "https://github.com/settings/apps/new?state=%s" % state)
    result, done = {}, threading.Event()

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def reply(self, body):
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(body.encode())

        def do_GET(self):
            if self.path == "/":
                self.reply('<form id="f" method="post" action="%s"><input type="hidden" name="manifest" value="%s">'
                           '<button>Create the Sheriff gate App</button></form><script>document.getElementById("f").submit()</script>'
                           % (html.escape(action), html.escape(json.dumps(manifest(owner, port)))))
            elif self.path.startswith("/callback?"):
                query = dict(part.split("=", 1) for part in self.path.split("?", 1)[1].split("&") if "=" in part)
                if query.get("state") != state or not query.get("code"):
                    self.reply("State mismatch: nothing was created here. Run gh sheriff install again.")
                    return
                request = urllib.request.Request("https://api.github.com/app-manifests/%s/conversions" % query["code"],
                                                 method="POST", headers={"Accept": "application/vnd.github+json"})
                with urllib.request.urlopen(request, timeout=30) as response:
                    result.update(json.load(response))
                self.reply("Sheriff gate App created. You can close this tab and go back to the terminal.")
                done.set()

    server = http.server.HTTPServer(("127.0.0.1", port), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    say("..  opening your browser to create the private gate App " + slug_for(owner) + " (one click: Create GitHub App)")
    open_url("http://127.0.0.1:%d/" % port)
    if not done.wait(900):
        server.shutdown()
        raise SheriffError("the gate App was not created within 15 minutes")
    server.shutdown()
    remember_app(result["slug"], result["id"])
    return int(result["id"]), result["pem"]


def key_from_downloads(slug, since):
    folder = pathlib.Path.home() / "Downloads"
    for _ in range(180):
        found = sorted((p for p in folder.glob(slug + "*.private-key.pem") if p.stat().st_mtime >= since),
                       key=lambda p: p.stat().st_mtime)
        if found:
            pem = found[-1].read_text()
            found[-1].unlink()
            return pem
        time.sleep(5)
    raise SheriffError("no new private key for " + slug + " appeared in ~/Downloads within 15 minutes")


def existing_app_key(info, slug):
    app_id = known_app_id(slug)
    settings = ("https://github.com/organizations/%s/settings/apps/%s" % (info["owner"], slug) if info["kind"] == "Organization"
                else "https://github.com/settings/apps/" + slug)
    if app_id is None:
        typed = input("App ID of " + slug + " (shown at the top of " + settings + "): ").strip()
        if not typed.isdigit():
            raise SheriffError("an App ID is a number")
        app_id = int(typed)
        remember_app(slug, app_id)
    say("..  on " + slug + "'s Key pairs page, click 'New key'. The downloaded file is read from ~/Downloads, stored, then deleted.")
    since = time.time()
    open_url(settings + "/key_pairs")
    return app_id, key_from_downloads(slug, since)


def ensure_gate_app(info, force_new_key=False, interactive=True):
    repo, slug = info["repo"], slug_for(info["owner"])
    have = env_secret_names(repo)
    if {"SHERIFF_APP_ID", "SHERIFF_APP_KEY_B64"} <= have and not force_new_key:
        app_id = known_app_id(slug)
        say("ok  gate App secrets are in the '" + ENVIRONMENT + "' environment" + (" (App " + str(app_id) + ")" if app_id else ""))
        return app_id, None
    if not interactive:
        raise SheriffError("the '" + ENVIRONMENT + "' environment of " + repo + " has no key for the gate App " + slug +
                           ": run gh sheriff install in a terminal without --yes once; it walks you through adding one")
    exists = known_app_id(slug) is not None or (input("Does a GitHub App named " + slug + " already exist? [y/N] ").strip().lower() == "y")
    app_id, pem = existing_app_key(info, slug) if exists else create_gate_app(info)
    set_env_secret(repo, "SHERIFF_APP_ID", str(app_id))
    set_env_secret(repo, "SHERIFF_APP_KEY_B64", base64.b64encode(pem.encode()).decode())
    say("ok  gate App " + slug + " (" + str(app_id) + "): its key went straight into the '" + ENVIRONMENT + "' environment")
    return app_id, pem


def installed(app_id, pem, repo):
    try:
        APP.api("GET", "/repos/" + repo + "/installation", APP.app_jwt(str(app_id), pem))
        return True
    except APP.AppTokenError:
        return False


def app_installation(info, slug):
    path = "/orgs/" + info["owner"] + "/installations" if info["kind"] == "Organization" else "/user/installations"
    rows = flat_pages(gh_json(["api", "--paginate", "--slurp", path]))
    found = next((row for page in rows for row in (page.get("installations") or []) if row.get("app_slug") == slug), None)
    if not found:
        return None, False
    if found.get("repository_selection") == "all":
        return found, True
    repos = flat_pages(gh_json(["api", "--paginate", "--slurp", "/user/installations/" + str(found["id"]) + "/repositories"]))
    return found, any(repo.get("full_name") == info["repo"] for page in repos for repo in (page.get("repositories") or []))


def installation_page(info, installation):
    if info["kind"] == "Organization":
        return "https://github.com/organizations/" + info["owner"] + "/settings/installations/" + str(installation["id"])
    return "https://github.com/settings/installations/" + str(installation["id"])


def ensure_installed(info, app_id, pem, wait=True):
    slug, repo = slug_for(info["owner"]), info["repo"]
    if pem is None:
        installation, covered = app_installation(info, slug)
        if covered:
            say("ok  " + slug + " is installed on " + repo)
            return
        page = installation_page(info, installation) if installation else "https://github.com/apps/" + slug + "/installations/new"
        owner_note = " (an organisation owner has to do this)" if info["kind"] == "Organization" else ""
        say("..  " + slug + " can't reach " + repo + " yet: on " + page + " add " + repo + " to its repositories" + owner_note)
        if not wait:
            raise SheriffError(slug + " is not installed on " + repo + "; add it on " + page + ", then run gh sheriff install again")
        open_url(page)
        for _ in range(180):
            time.sleep(5)
            if app_installation(info, slug)[1]:
                say("ok  " + slug + " is installed on " + repo)
                return
        raise SheriffError(slug + " is not installed on " + repo + " after 15 minutes")
    if installed(app_id, pem, repo):
        say("ok  " + slug + " is installed on " + repo)
        return
    say("..  opening the install page: choose 'Only select repositories', pick " + repo + ", then Install")
    open_url("https://github.com/apps/" + slug + "/installations/new")
    for _ in range(180):
        if installed(app_id, pem, repo):
            say("ok  " + slug + " is installed on " + repo)
            return
        time.sleep(5)
    raise SheriffError(slug + " is not installed on " + repo + " after 15 minutes")


def flat_pages(pages):
    return [page for page in (pages or []) if isinstance(page, dict)]


def repo_variable(repo, name):
    out = subprocess.run(["gh", "variable", "get", name, "--repo", repo], capture_output=True, text=True, check=False)
    return out.stdout.strip() if out.returncode == 0 else ""


def set_variable(repo, name, value):
    if value:
        gh(["variable", "set", name, "--repo", repo, "--body", value])
    else:
        subprocess.run(["gh", "variable", "delete", name, "--repo", repo], capture_output=True, check=False)


def choose_reviewers(info, first_pass=None, final=None, interactive=True):
    repo = info["repo"]
    current_first, current_final = repo_variable(repo, "SHERIFF_FIRST_PASS"), repo_variable(repo, "SHERIFF_REVIEW_MODEL")
    if first_pass is None and interactive:
        say("..  Cheap first-pass reviewer: it reviews every new commit first, and the final reviewer runs only when it is clean")
        say("    (or after 3 cheap rounds on a pull request). Docs-only changes never reach the final reviewer while cheap rounds remain.")
        for index, (label, spec) in enumerate(FIRST_PASS_CHOICES, 1):
            say("    " + str(index) + ") " + label + ("  [" + spec + "]" if spec else ""))
        picked = input("Choose 1-3 (Enter keeps " + (current_first or "none") + "): ").strip()
        if picked in ("1", "2", "3"):
            first_pass = FIRST_PASS_CHOICES[int(picked) - 1][1]
            if first_pass:
                model = input("Model (Enter for " + first_pass.split(":", 1)[1] + "): ").strip()
                first_pass = first_pass.split(":", 1)[0] + ":" + model if model else first_pass
        else:
            first_pass = current_first
    if final is None and interactive:
        typed = input("Final reviewer (Enter keeps " + (current_final or DEFAULT_FINAL) + "): ").strip()
        final = typed or current_final or DEFAULT_FINAL
    first_pass = current_first if first_pass is None else first_pass
    final = (current_final or DEFAULT_FINAL) if final is None else final
    specs = [spec for spec in (REVIEWERS.parse_spec(first_pass), REVIEWERS.parse_spec(final)) if spec]
    set_variable(repo, "SHERIFF_FIRST_PASS", first_pass)
    set_variable(repo, "SHERIFF_REVIEW_MODEL", final)
    say("ok  reviewers: first pass " + (first_pass or "none") + ", final " + final)
    return sorted({REVIEWERS.SECRETS[provider] for provider, _ in specs})


def ensure_secrets(info, names, rotate=False):
    repo, have = info["repo"], env_secret_names(info["repo"], REVIEW_ENVIRONMENT)
    for name in names:
        if name in have and not rotate:
            say("ok  " + name + " is in the '" + REVIEW_ENVIRONMENT + "' environment")
            continue
        label, prefix = SECRET_PROMPTS[name]
        value = "".join((os.environ.get(name) or "").split())
        if not value:
            value = "".join(getpass.getpass(label + " (hidden): ").split())
        if not value or (prefix and not value.startswith(prefix)):
            raise SheriffError("that does not look like a " + name)
        set_env_secret(repo, name, value, REVIEW_ENVIRONMENT)
        say("ok  " + name + " stored in the '" + REVIEW_ENVIRONMENT + "' environment")


RELEASE = "v1"
SHERIFF_REPO = "nick-the-dev/gh-sheriff"


def template_text(name):
    released = remote_file(SHERIFF_REPO, "templates/" + name, RELEASE)
    if released is None:
        say("..  cannot read Sheriff " + RELEASE + "'s templates; using the installed copy (gh extension upgrade sheriff)")
        return (HOME / "templates" / name).read_text()
    if released != (HOME / "templates" / name).read_text():
        say("..  this gh sheriff is older than Sheriff " + RELEASE + ": run gh extension upgrade sheriff")
    return released


def remote_file(repo, path, ref):
    out = subprocess.run(["gh", "api", "repos/" + repo + "/contents/" + path + "?ref=" + ref], capture_output=True, text=True, check=False)
    if out.returncode:
        return None
    return base64.b64decode(json.loads(out.stdout)["content"]).decode()


def trigger_files_current(info):
    return all(remote_file(info["repo"], ".github/workflows/" + name, info["branch"]) == (HOME / "templates" / name).read_text()
               for name in TEMPLATES)


INSTALL_BRANCH = re.compile(r"sheriff-install-\d{14}-[0-9a-f]{6}")


def verify_install_pr(repo, number, head_sha, paths):
    pull = gh_json(["api", "repos/" + repo + "/pulls/" + str(number)])
    files = {row["filename"] for row in (gh_json(["api", "repos/" + repo + "/pulls/" + str(number) + "/files?per_page=100"]) or [])}
    if ((pull.get("head") or {}).get("repo") or {}).get("full_name") != repo:
        raise SheriffError("pull request " + str(number) + " does not come from " + repo)
    if (pull.get("head") or {}).get("sha") != head_sha:
        raise SheriffError("pull request " + str(number) + " head is not the commit gh sheriff wrote")
    if files != paths:
        raise SheriffError("pull request " + str(number) + " changes " + ", ".join(sorted(files)) + ", not only the trigger files")


def ensure_trigger_files(info, wait_merge=True):
    repo, branch = info["repo"], info["branch"]
    wanted = {".github/workflows/" + name: template_text(name) for name in TEMPLATES}
    stale = {path: text for path, text in wanted.items() if remote_file(repo, path, branch) != text}
    if not stale:
        say("ok  trigger files are current on " + branch)
        return None
    me = gh(["api", "user", "--jq", ".login"]).strip()
    listed = gh_json(["pr", "list", "--repo", repo, "--state", "open", "--limit", "200",
                      "--json", "number,headRefName,isCrossRepository,title,author"]) or []
    for stale_pr in listed:
        if (INSTALL_BRANCH.fullmatch(str(stale_pr.get("headRefName") or "")) and not stale_pr.get("isCrossRepository")
                and stale_pr.get("title") == "Install Sheriff" and (stale_pr.get("author") or {}).get("login") == me):
            gh(["pr", "close", str(stale_pr["number"]), "--repo", repo, "--delete-branch", "--comment", "Replaced by a newer gh sheriff install."])
            say("ok  closed the older install pull request #" + str(stale_pr["number"]))
    work = "sheriff-install-" + time.strftime("%Y%m%d%H%M%S") + "-" + secrets.token_hex(3)
    base_sha = gh_json(["api", "repos/" + repo + "/git/ref/heads/" + branch])["object"]["sha"]
    base_tree = gh_json(["api", "repos/" + repo + "/git/commits/" + base_sha])["tree"]["sha"]
    tree = gh_json(["api", "-X", "POST", "repos/" + repo + "/git/trees", "--input", "-"], json.dumps({
        "base_tree": base_tree, "tree": [{"path": path, "mode": "100644", "type": "blob", "content": text} for path, text in sorted(stale.items())]}))["sha"]
    head_sha = gh_json(["api", "-X", "POST", "repos/" + repo + "/git/commits", "--input", "-"], json.dumps({
        "message": "Install Sheriff: update the trigger files", "tree": tree, "parents": [base_sha]}))["sha"]
    gh(["api", "-X", "POST", "repos/" + repo + "/git/refs", "-f", "ref=refs/heads/" + work, "-f", "sha=" + head_sha])
    created = gh_json(["api", "-X", "POST", "repos/" + repo + "/pulls", "--input", "-"], json.dumps({
        "title": "Install Sheriff", "head": work, "base": branch,
        "body": "Adds or updates Sheriff's trigger files (" + ", ".join("`" + path + "`" for path in sorted(stale)) + ") to match the "
                "released Sheriff v1 templates (https://github.com/nick-the-dev/gh-sheriff/tree/v1/templates). Created by gh sheriff install."}))
    pr = {"url": created["html_url"], "number": created["number"]}
    verify_install_pr(repo, pr["number"], head_sha, set(stale))
    say("ok  pull request with the trigger files: " + pr["url"])
    if not wait_merge:
        return pr
    merged = subprocess.run(["gh", "pr", "merge", str(pr["number"]), "--repo", repo, "--squash", "--delete-branch",
                             "--match-head-commit", head_sha], capture_output=True, text=True, check=False)
    if merged.returncode:
        armed = subprocess.run(["gh", "pr", "merge", str(pr["number"]), "--repo", repo, "--squash", "--auto",
                                "--match-head-commit", head_sha],
                               capture_output=True, text=True, check=False)
        if armed.returncode:
            raise SheriffError("could not merge or arm auto-merge on " + pr["url"] + ": " + (armed.stderr or merged.stderr).strip()[:200])
        say("..  waiting for Sheriff to review " + pr["url"] + " and merge it (auto-merge is armed)")
        for _ in range(180):
            state = gh_json(["pr", "view", str(pr["number"]), "--repo", repo, "--json", "state"])["state"]
            if state == "MERGED":
                break
            if state == "CLOSED":
                raise SheriffError(pr["url"] + " was closed")
            time.sleep(10)
        else:
            raise SheriffError(pr["url"] + " has not merged after 30 minutes; see its Review check")
    say("ok  merged the trigger files into " + branch)
    return pr


def ensure_auto_merge(info):
    if not info["auto_merge"]:
        gh(["api", "-X", "PATCH", "repos/" + info["repo"], "-F", "allow_auto_merge=true"])
    say("ok  auto-merge is on: a pull request merges itself once every required check is green")


def run_ids(repo):
    runs = gh_json(["run", "list", "--repo", repo, "--workflow", "sheriff.yml", "--limit", "20", "--json", "databaseId"]) or []
    return {run["databaseId"] for run in runs}


def first_run(info):
    repo = info["repo"]
    before = run_ids(repo)
    gh(["workflow", "run", "sheriff.yml", "--repo", repo, "--ref", info["branch"]])
    run_id = None
    for _ in range(60):
        fresh = sorted(run_ids(repo) - before)
        if fresh:
            run_id = fresh[-1]
            break
        time.sleep(5)
    if run_id is None:
        raise SheriffError("the first Sheriff run did not start")
    conclusion = None
    for _ in range(5):
        for _ in range(240):
            view = gh_json(["run", "view", str(run_id), "--repo", repo, "--json", "status,conclusion"])
            if view.get("status") == "completed":
                break
            time.sleep(5)
        conclusion = view.get("conclusion") or "unfinished after 20 minutes"
        newer = sorted(i for i in run_ids(repo) - before if i > run_id)
        if conclusion != "cancelled" or not newer:
            break
        say("..  run " + str(run_id) + " was replaced by a newer Sheriff run; following " + str(newer[-1]))
        run_id = newer[-1]
    if conclusion != "success":
        raise SheriffError("the first Sheriff run ended " + str(conclusion) + ": gh run view " + str(run_id) + " --repo " + repo + " --log-failed")
    say("ok  first Sheriff run succeeded (run " + str(run_id) + ")")


def existing_required_checks(repo, branch):
    checks = {}
    rules = gh_json(["api", "repos/" + repo + "/rules/branches/" + branch]) or []
    for rule in rules:
        if rule.get("type") == "required_status_checks" and rule.get("ruleset_source") != repo + ":" + RULESET:
            for check in (rule.get("parameters") or {}).get("required_status_checks", []):
                checks.setdefault(check["context"], check.get("integration_id"))
    classic = subprocess.run(["gh", "api", "repos/" + repo + "/branches/" + branch + "/protection/required_status_checks"],
                             capture_output=True, text=True, check=False)
    if classic.returncode == 0:
        for check in json.loads(classic.stdout).get("checks", []):
            checks.setdefault(check["context"], check.get("app_id"))
    return checks


def build_ruleset(existing, app_id):
    required = [{"context": context, **({"integration_id": int(integration)} if integration else {})}
                for context, integration in sorted(existing.items()) if context not in STATUSES]
    required += [{"context": context, "integration_id": int(app_id)} for context in STATUSES]
    return {"name": RULESET, "target": "branch", "enforcement": "active",
            "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
            "bypass_actors": [],
            "rules": [{"type": "deletion"}, {"type": "non_fast_forward"},
                      {"type": "pull_request", "parameters": {"required_approving_review_count": 0, "dismiss_stale_reviews_on_push": True,
                                                              "require_code_owner_review": False, "require_last_push_approval": False,
                                                              "required_review_thread_resolution": True}},
                      {"type": "required_status_checks", "parameters": {"strict_required_status_checks_policy": False,
                                                                        "do_not_enforce_on_create": False,
                                                                        "required_status_checks": required}}]}


def gate_statuses_seen(repo, app_slug):
    pulls = gh_json(["pr", "list", "--repo", repo, "--state", "open", "--limit", "20", "--json", "headRefOid"]) or []
    for pull in pulls:
        rows = gh_json(["api", "repos/" + repo + "/commits/" + pull["headRefOid"] + "/statuses?per_page=50"]) or []
        if any(row.get("context") in STATUSES and (row.get("creator") or {}).get("login") == app_slug + "[bot]" for row in rows):
            return True
    return False


def ensure_ruleset(info, app_id, assume_yes=False):
    repo = info["repo"]
    rulesets = gh_json(["api", "repos/" + repo + "/rulesets"]) or []
    current = next((item for item in rulesets if item.get("name") == RULESET), None)
    if app_id is None:
        raise SheriffError("the gate App id is unknown; rerun with the App ID at hand")
    ruleset = build_ruleset(existing_required_checks(repo, info["branch"]), app_id)
    checks = ", ".join(c["context"] for c in ruleset["rules"][3]["parameters"]["required_status_checks"])
    if current is None:
        say("..  the '" + RULESET + "' ruleset will require on " + info["branch"] + ": " + checks + "; no bypass, not even for admins")
        if not assume_yes and input("Apply it now? [y/N] ").strip().lower() != "y":
            say("--  ruleset not applied; run gh sheriff install again to apply it")
            return
        created = gh_json(["api", "-X", "POST", "repos/" + repo + "/rulesets", "--input", "-"], json.dumps(ruleset))
        say("ok  ruleset '" + RULESET + "' (" + str(created["id"]) + ") is active")
    else:
        gh_json(["api", "-X", "PUT", "repos/" + repo + "/rulesets/" + str(current["id"]), "--input", "-"], json.dumps(ruleset))
        say("ok  ruleset '" + RULESET + "' is current: " + checks)

FIELDS_QUERY = """query($owner:String!,$name:String!){repository(owner:$owner,name:$name){id
 owner{__typename id login ... on User{databaseId}}
 issueTypes(first:50){nodes{name}}
 issueFields(first:50){nodes{__typename ... on IssueFieldSingleSelect{id name options{name}} ... on IssueFieldText{id name}}}}}"""
CREATE_FIELD = "mutation($input:CreateIssueFieldInput!){createIssueField(input:$input){issueField{__typename}}}"
PROJECTS_QUERY = """query($login:String!,$title:String!){repositoryOwner(login:$login){
 ... on ProjectV2Owner{projectsV2(first:100,query:$title){nodes{id number title url}}}}}"""
PROJECT_QUERY = """query($id:ID!){node(id:$id){... on ProjectV2{repositories(first:100){nodes{id}}
 fields(first:50){nodes{... on ProjectV2FieldCommon{databaseId name isIssueField}}} views(first:50){nodes{name}}}}}"""
CREATE_PROJECT = "mutation($input:CreateProjectV2Input!){createProjectV2(input:$input){projectV2{id number title url}}}"
LINK_REPOSITORY = "mutation($input:LinkProjectV2ToRepositoryInput!){linkProjectV2ToRepository(input:$input){clientMutationId}}"
LINK_FIELD = """mutation($input:CreateProjectV2IssueFieldInput!){createProjectV2IssueField(input:$input){
 projectV2Field{... on ProjectV2FieldCommon{databaseId name isIssueField}}}}"""


def work_fields(info):
    owner, name = info["repo"].split("/")
    return WORK.gql(FIELDS_QUERY, {"owner": owner, "name": name})["repository"]


def field_problems(repository):
    present = {node.get("name"): node for node in repository["issueFields"]["nodes"] if node.get("name")}
    problems = []
    for name, kind, options in FIELD_SPECS:
        node = present.get(name)
        if node is None:
            problems.append("no issue field '" + name + "'")
        elif node.get("__typename") != FIELD_TYPES[kind]:
            problems.append("the issue field '" + name + "' is not " + kind.lower().replace("_", " "))
        elif [option for option in options if option not in {o.get("name") for o in node.get("options") or []}]:
            problems.append("the issue field '" + name + "' lacks the options " + ", ".join(
                option for option in options if option not in {o.get("name") for o in node.get("options") or []}))
    return problems


def ensure_issue_fields(info):
    repository = work_fields(info)
    present = {node.get("name") for node in repository["issueFields"]["nodes"]}
    scope = "admin:org" if info["kind"] == "Organization" else "user"
    for name, kind, options in FIELD_SPECS:
        if name in present:
            continue
        field = {"ownerId": repository["owner"]["id"], "name": name, "dataType": kind}
        if options:
            field["options"] = [{"name": option, "color": OPTION_COLORS[index % len(OPTION_COLORS)], "priority": index + 1}
                                for index, option in enumerate(options)]
        try:
            WORK.gql(CREATE_FIELD, {"input": field})
            say("ok  issue field '" + name + "' created for " + info["owner"])
        except WORK.WorkError as exc:
            say("!!  cannot create the issue field '" + name + "': " + str(exc)[:200])
            say("    if gh lacks the scope: gh auth refresh -s " + scope + ", then gh sheriff install again")
    repository = work_fields(info)
    problems = field_problems(repository)
    for line in problems:
        say("!!  " + line)
    if not problems:
        say("ok  issue fields Stage, Verify by and Next action exist for " + info["owner"])
    return repository


WORKFLOWS_QUERY = """query($id:ID!){node(id:$id){... on ProjectV2{workflows(first:50){nodes{name enabled}}}}}"""
AUTO_ADD = "Auto-add to project"


def auto_add_on(project):
    nodes = ((WORK.gql(WORKFLOWS_QUERY, {"id": project["id"]}).get("node") or {}).get("workflows") or {}).get("nodes") or []
    return any(node.get("name") == AUTO_ADD and node.get("enabled") for node in nodes)


def wait_for_auto_add(info, project, wait):
    page = project["url"] + "/workflows"
    if auto_add_on(project):
        say("ok  '" + AUTO_ADD + "' is on: every new issue joins the board")
        return True
    say("..  GitHub has no API to switch on '" + AUTO_ADD + "'. On " + page + " choose '" + AUTO_ADD + "',")
    say("    pick " + info["repo"] + ", set the filter to is:issue, save, and turn it on")
    if not wait:
        return False
    if OPEN_BROWSER:
        webbrowser.open(page)
    say("..  waiting until it is on (Ctrl+C skips; gh sheriff doctor checks it later)")
    try:
        for _ in range(120):
            time.sleep(5)
            if auto_add_on(project):
                say("ok  '" + AUTO_ADD + "' is on: every new issue joins the board")
                return True
    except KeyboardInterrupt:
        say("--  skipped; turn it on later at " + page)
        return False
    say("--  still off after 10 minutes; turn it on at " + page)
    return False


def find_project(info, title):
    owner = WORK.gql(PROJECTS_QUERY, {"login": info["owner"], "title": title})["repositoryOwner"] or {}
    return next((project for project in (owner.get("projectsV2") or {}).get("nodes") or [] if project.get("title") == title), None)


def view_specs(stage, decision):
    return (("Needs human", "table", "is:open " + decision, {}),
            ("Blocked", "table", "is:open is:blocked -" + decision, {"group_by": [stage]}),
            ("Ready", "table", "is:open stage:Candidate -is:blocked", {}),
            ("In flight", "board", 'stage:"In progress",Merged', {"vertical_group_by": [stage]}),
            ("Awaiting verification", "table", "stage:Released", {}),
            ("All open by stage", "table", "is:open -" + decision, {"group_by": [stage]}))


def views_path(info, repository, project):
    owner = "orgs/" + info["owner"] if info["kind"] == "Organization" else "users/" + info["owner"]
    return owner + "/projectsV2/" + str(project["number"]) + "/views"


def ensure_views(info, repository, project, fields, existing):
    if "Stage" not in fields:
        say("!!  the project has no Stage field, so its views are not created")
        return
    decision = "type:Decision" if "Decision" in {node.get("name") for node in repository["issueTypes"]["nodes"]} else "label:" + WORK.DECISION_LABEL
    visible = [fields[name]["databaseId"] for name in ("Title", "Assignees", "Stage", "Verify by", "Next action", "Linked pull requests") if name in fields]
    for name, layout, query, grouping in view_specs(fields["Stage"]["databaseId"], decision):
        if name in existing:
            continue
        body = dict({"name": name, "layout": layout, "filter": query, "visible_fields": visible}, **grouping)
        try:
            gh_json(["api", "-X", "POST", views_path(info, repository, project), "-H", "X-GitHub-Api-Version: " + VIEWS_API_VERSION,
                     "--input", "-"], json.dumps(body))
        except SheriffError as exc:
            say("!!  cannot create the view '" + name + "': " + str(exc)[:200])
            return
        say("ok  view '" + name + "'")


def ensure_project(info, title, repository):
    project = find_project(info, title)
    if project is None:
        project = WORK.gql(CREATE_PROJECT, {"input": {"ownerId": repository["owner"]["id"], "title": title,
                                                      "repositoryId": repository["id"]}})["createProjectV2"]["projectV2"]
        say("ok  project '" + title + "' created for " + info["owner"])
    detail = WORK.gql(PROJECT_QUERY, {"id": project["id"]})["node"]
    if repository["id"] not in {node["id"] for node in detail["repositories"]["nodes"]}:
        WORK.gql(LINK_REPOSITORY, {"input": {"projectId": project["id"], "repositoryId": repository["id"]}})
    fields = {node["name"]: node for node in detail["fields"]["nodes"] if node.get("name")}
    issue_fields = {node["name"]: node for node in repository["issueFields"]["nodes"] if node.get("name")}
    for name, _, _ in FIELD_SPECS:
        if name in fields and not fields[name].get("isIssueField"):
            say("!!  the project has its own field '" + name + "': rename it so the issue field can be shown")
            fields.pop(name)
        elif name not in fields and name in issue_fields:
            fields[name] = WORK.gql(LINK_FIELD, {"input": {"projectId": project["id"], "issueFieldId": issue_fields[name]["id"]}})[
                "createProjectV2IssueField"]["projectV2Field"]
            say("ok  issue field '" + name + "' added to the project")
    ensure_views(info, repository, project, fields, {node["name"] for node in detail["views"]["nodes"]})
    return project


def ensure_work_state(info, title, wait=False):
    try:
        WORK.use_repo(info["repo"])
        repository = ensure_issue_fields(info)
        project = ensure_project(info, title, repository)
        tasks = [item for item in WORK.issues("OPEN") if item.get("id") or item.get("stage")]
        if tasks:
            say("ok  " + str(WORK.add_to_board(project["id"], tasks)) + " open task issue(s) are on the board")
    except WORK.WorkError as exc:
        say("!!  work state: " + str(exc)[:300])
        say("    if gh lacks a scope: gh auth refresh -s project (and -s " + ("admin:org" if info["kind"] == "Organization" else "user") +
            "), then gh sheriff install again")
        return False
    say("ok  project '" + title + "': " + project["url"])
    wait_for_auto_add(info, project, wait)
    return not field_problems(repository)


def work_state_problems(info, title):
    try:
        problems = field_problems(work_fields(info))
    except WORK.WorkError as exc:
        problems = ["cannot read the issue fields: " + str(exc)[:200]]
    try:
        project = find_project(info, title)
        if project is None:
            problems.append("no project '" + title + "' owned by " + info["owner"])
        elif not auto_add_on(project):
            problems.append("'" + AUTO_ADD + "' is off on the board: turn it on at " + project["url"] + "/workflows")
    except WORK.WorkError as exc:
        problems.append("cannot read the projects of " + info["owner"] + " (gh auth refresh -s project): " + str(exc)[:200])
    return problems


def install(args):
    info = repo_info(resolve_repo(args.repo))
    if not info["admin"]:
        raise SheriffError("installing Sheriff needs admin rights on " + info["repo"])
    say("Sheriff for " + info["repo"] + " (" + ("organisation" if info["kind"] == "Organization" else "personal account") + ", default branch " + info["branch"] + ")")
    ensure_environment(info)
    ensure_environment(info, REVIEW_ENVIRONMENT)
    app_id, pem = ensure_gate_app(info, args.new_key, sys.stdin.isatty() and not args.yes)
    app_id = app_id or known_app_id(slug_for(info["owner"]))
    if app_id:
        set_variable(info["repo"], "SHERIFF_APP_ID", str(app_id))
    set_variable(info["repo"], "SHERIFF_APP_SLUG", slug_for(info["owner"]))
    ensure_installed(info, app_id, pem, sys.stdin.isatty() and not args.yes)
    interactive = sys.stdin.isatty() and not args.yes
    ensure_secrets(info, choose_reviewers(info, args.first_pass, args.review_model, interactive), args.rotate_secrets)
    if args.no_files and not trigger_files_current(info):
        ensure_auto_merge(info)
        say("--  stopped before the trigger files (--no-files): add .github/workflows/sheriff.yml and sheriff-relay.yml from")
        say("    " + str(HOME / "templates") + " through your own pull request, then run gh sheriff install again")
        return
    ensure_trigger_files(info)
    ensure_auto_merge(info)
    first_run(info)
    ensure_ruleset(info, app_id, args.yes)
    if not args.no_work_state:
        if ensure_work_state(info, args.project_name or WORK.board_title(info["repo"]), sys.stdin.isatty() and not args.yes):
            set_variable(info["repo"], "SHERIFF_WORK_STATE", "on")
            say("ok  work state is on: pull requests and releases move each task's Stage")
        else:
            say("--  work state stays off until the issue fields exist")
    say("Done. Every new pull request head is now reviewed by Sheriff, and GitHub merges only what Sheriff marks green.")


def doctor(args):
    info = repo_info(resolve_repo(args.repo))
    repo, slug = info["repo"], slug_for(info["owner"])
    problems = []
    secrets_present = env_secret_names(repo)
    needed, review_needed = ["SHERIFF_APP_ID", "SHERIFF_APP_KEY_B64"], []
    for variable, fallback in (("SHERIFF_FIRST_PASS", ""), ("SHERIFF_REVIEW_MODEL", DEFAULT_FINAL)):
        try:
            spec = REVIEWERS.parse_spec(repo_variable(repo, variable) or fallback)
        except REVIEWERS.ReviewerError as exc:
            problems.append(str(exc))
            spec = None
        if spec:
            review_needed.append(REVIEWERS.SECRETS[spec[0]])
    review_present = env_secret_names(repo, REVIEW_ENVIRONMENT)
    for name in sorted(set(review_needed)):
        if name not in review_present:
            problems.append("missing secret " + name + " in the '" + REVIEW_ENVIRONMENT + "' environment")
    for name in sorted(set(review_needed) & secrets_present):
        problems.append(name + " is also in the '" + ENVIRONMENT + "' environment, next to the App key: delete it there")
    for variable in ("SHERIFF_APP_ID", "SHERIFF_APP_SLUG"):
        if not repo_variable(repo, variable):
            problems.append("repository variable " + variable + " is not set")
    for name in sorted(set(needed)):
        if name not in secrets_present:
            problems.append("missing secret " + name + " in the '" + ENVIRONMENT + "' environment")
    for environment in (ENVIRONMENT, REVIEW_ENVIRONMENT):
        policies = subprocess.run(["gh", "api", "repos/" + repo + "/environments/" + environment + "/deployment-branch-policies",
                                   "--jq", "[.branch_policies[].name]"], capture_output=True, text=True, check=False)
        if policies.returncode or json.loads(policies.stdout or "[]") != [info["branch"]]:
            problems.append("the '" + environment + "' environment is not limited to " + info["branch"] + " alone")
    for name in TEMPLATES:
        if remote_file(repo, ".github/workflows/" + name, info["branch"]) != template_text(name):
            problems.append(".github/workflows/" + name + " is missing or differs from this Sheriff version")
    if not repo_info(repo)["auto_merge"]:
        problems.append("auto-merge is off")
    rulesets = gh_json(["api", "repos/" + repo + "/rulesets"]) or []
    current = next((item for item in rulesets if item.get("name") == RULESET), None)
    if current is None:
        problems.append("no '" + RULESET + "' ruleset")
    else:
        detail = gh_json(["api", "repos/" + repo + "/rulesets/" + str(current["id"])])
        pinned = {c["context"]: c.get("integration_id") for rule in detail.get("rules", []) if rule.get("type") == "required_status_checks"
                  for c in rule["parameters"]["required_status_checks"]}
        app_id = known_app_id(slug)
        for context in STATUSES:
            if context not in pinned or (app_id and pinned[context] != app_id):
                problems.append("the ruleset does not require '" + context + "' from " + slug)
        if detail.get("bypass_actors"):
            problems.append("the ruleset has bypass actors")
        if detail.get("enforcement") != "active":
            problems.append("the ruleset is not active")
    if repo_variable(repo, "SHERIFF_WORK_STATE") == "on" and not args.no_work_state:
        problems += work_state_problems(info, args.project_name or WORK.board_title(repo))
    elif not args.no_work_state:
        say("--  work state is off (repository variable SHERIFF_WORK_STATE is not 'on'); gh sheriff install turns it on")
    for line in problems:
        say("!!  " + line)
    say("ok  Sheriff is set up correctly on " + repo if not problems else str(len(problems)) + " problem(s); gh sheriff install fixes them")
    return 1 if problems else 0


def models(args):
    info = repo_info(resolve_repo(args.repo))
    ensure_environment(info, REVIEW_ENVIRONMENT)
    interactive = sys.stdin.isatty() and args.first_pass is None and args.review_model is None
    ensure_secrets(info, choose_reviewers(info, args.first_pass, args.review_model, interactive), args.rotate_secrets)
    return 0


def tokens(usage, with_reads=True):
    return sum(int(usage.get(key) or 0) for key in ("input", "cache_write", "output")) + (int(usage.get("cache_read") or 0) if with_reads else 0)


def usage_rows(repo, app_id, limit):
    rows = []
    pulls = gh_json(["pr", "list", "--repo", repo, "--state", "all", "--limit", str(limit), "--json", "number"]) or []
    for pull in pulls:
        shas = gh_json(["api", "repos/" + repo + "/pulls/" + str(pull["number"]) + "/commits?per_page=100", "--jq", "[.[].sha]"]) or []
        for sha in shas:
            data = gh_json(["api", "repos/" + repo + "/commits/" + sha + "/check-runs?check_name=Review&per_page=20"]) or {}
            for check in data.get("check_runs", []):
                if app_id and (check.get("app") or {}).get("id") != app_id:
                    continue
                try:
                    record = json.loads(((check.get("output") or {}).get("text")) or "{}")
                except ValueError:
                    continue
                for item in record.get("usage", []) if record.get("sheriff_usage") == 1 else []:
                    rows.append({"pr": pull["number"], "stage": item.get("stage"), "model": item.get("model"), "usage": item.get("usage") or {}})
    return rows


def summarise(rows):
    by_model = {}
    for row in rows:
        entry = by_model.setdefault((row["stage"], row["model"]), {"reviews": 0, "tokens": 0, "tokens_no_reads": 0, "cost": 0.0})
        entry["reviews"] += 1
        entry["tokens"] += tokens(row["usage"])
        entry["tokens_no_reads"] += tokens(row["usage"], with_reads=False)
        entry["cost"] += float(row["usage"].get("cost_usd") or 0)
    total = {key: sum(entry[key] for entry in by_model.values()) for key in ("reviews", "tokens", "tokens_no_reads", "cost")}
    smart = {key: sum(entry[key] for (stage, _), entry in by_model.items() if stage == "final") for key in total}
    share = {key: (smart[key] / total[key] * 100 if total[key] else 0.0) for key in total}
    return by_model, total, share


def stats(args):
    info = repo_info(resolve_repo(args.repo))
    app_id = known_app_id(slug_for(info["owner"]))
    by_model, total, share = summarise(usage_rows(info["repo"], app_id, args.prs))
    say("Sheriff reviews on the last " + str(args.prs) + " pull requests of " + info["repo"])
    for (stage, model), entry in sorted(by_model.items()):
        say("  %-6s %-40s %4d reviews  %12d tokens  %12d without cache reads  $%.2f" % (
            stage, model, entry["reviews"], entry["tokens"], entry["tokens_no_reads"], entry["cost"]))
    say("  smart-model (final reviewer) share: %.1f%% of tokens, %.1f%% without cache reads, %.1f%% of reviews, %.1f%% of cost" % (
        share["tokens"], share["tokens_no_reads"], share["reviews"], share["cost"]))
    limit = float(repo_variable(info["repo"], "SHERIFF_SMART_SHARE_LIMIT") or args.limit)
    if total["reviews"] < 10:
        say("    (only " + str(total["reviews"]) + " reviews so far; the target is judged from 10 on)")
        return 0
    if share["tokens_no_reads"] > limit:
        say("!!  above the " + str(limit) + "% target: check the cheap first pass is set (gh sheriff models) and catching problems early")
        return 1
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="gh sheriff", description="Agents code. The Sheriff decides what merges.")
    sub = parser.add_subparsers(dest="command", required=True)
    install_parser = sub.add_parser("install", help="set Sheriff up on a repository (safe to run again)")
    install_parser.add_argument("--repo", help="owner/name (default: the repository in the current folder)")
    install_parser.add_argument("--yes", action="store_true", help="apply the ruleset without asking")
    install_parser.add_argument("--new-key", action="store_true", help="store a fresh gate App key even if one is set")
    install_parser.add_argument("--rotate-secrets", action="store_true", help="replace the stored reviewer keys")
    install_parser.add_argument("--first-pass", help="cheap first-pass reviewer as provider:model, or '' for none")
    install_parser.add_argument("--review-model", help="final reviewer as provider:model (default claude:claude-opus-5-5)")
    install_parser.add_argument("--no-browser", action="store_true", help="print the pages to open instead of opening them")
    install_parser.add_argument("--no-files", action="store_true", help="do not open a pull request with the trigger files; add them yourself")
    install_parser.add_argument("--no-work-state", action="store_true", help="skip the issue fields and the project board")
    install_parser.add_argument("--project-name", help="title of the repository's project board (default: the repository's name plus ' work')")
    models_parser = sub.add_parser("models", help="choose the cheap first-pass and the final reviewer")
    models_parser.add_argument("--repo", help="owner/name (default: the repository in the current folder)")
    models_parser.add_argument("--first-pass", help="provider:model, or '' for none")
    models_parser.add_argument("--review-model", help="provider:model")
    models_parser.add_argument("--rotate-secrets", action="store_true", help="replace the stored reviewer keys")
    stats_parser = sub.add_parser("stats", help="how much of the review work the smart model does")
    stats_parser.add_argument("--repo", help="owner/name (default: the repository in the current folder)")
    stats_parser.add_argument("--prs", type=int, default=50, help="how many recent pull requests to count")
    stats_parser.add_argument("--limit", type=float, default=10.0, help="target smart-model share in percent")
    doctor_parser = sub.add_parser("doctor", help="check that Sheriff is set up correctly")
    doctor_parser.add_argument("--repo", help="owner/name (default: the repository in the current folder)")
    doctor_parser.add_argument("--no-work-state", action="store_true", help="do not check the issue fields and the project board")
    doctor_parser.add_argument("--project-name", help="title of the repository's project board (default: the repository's name plus ' work')")
    task_parser = sub.add_parser("task", help="record work as issues whose Stage follows pull requests and releases")
    WORK.add_commands(task_parser)
    args = parser.parse_args(argv)
    global OPEN_BROWSER
    OPEN_BROWSER = not getattr(args, "no_browser", False)
    try:
        if args.command == "install":
            install(args)
            return 0
        if args.command == "task":
            return WORK.run_cli(args)
        return {"models": models, "stats": stats, "doctor": doctor}[args.command](args)
    except SheriffError as exc:
        say("!!  " + str(exc))
        return 1
    except KeyboardInterrupt:
        say("\nstopped; gh sheriff install can be run again safely")
        return 130


if __name__ == "__main__":
    sys.exit(main())
